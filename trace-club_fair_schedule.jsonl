{"args": {"content": "import sys\nfrom collections import deque\n\n\ndef main() -> None:\n    data = sys.stdin.read().splitlines()\n    if not data:\n        return\n    h, w = map(int, data[0].split())\n    grid = data[1:1+h]\n\n    start = None\n    target = None\n    for r in range(h):\n        row = grid[r]\n        for c in range(w):\n            ch = row[c]\n            if ch == 'S':\n                start = (r, c)\n            elif ch == 'T':\n                target = (r, c)\n\n    if start is None or target is None:\n        print(-1)\n        return\n\n    sr, sc = start\n    tr, tc = target\n\n    # BFS\n    dist = [[-1]*w for _ in range(h)]\n    dq = deque()\n    dist[sr][sc] = 0\n    dq.append((sr, sc))\n    moves = [(1,0),(-1,0),(0,1),(0,-1)]\n    while dq:\n        r, c = dq.popleft()\n        if (r, c) == (tr, tc):\n            print(dist[r][c])\n            return\n        for dr, dc in moves:\n            nr, nc = r+dr, c+dc\n            if 0 <= nr < h and 0 <= nc < w and dist[nr][nc] == -1 and grid[nr][nc] != '#':\n                dist[nr][nc] = dist[r][c] + 1\n                dq.append((nr, nc))\n\n    print(-1)\n\n\nif __name__ == '__main__':\n    main()\n", "reason": "Implement BFS shortest path considering walls"}, "iteration": 4, "tool": "write_solution", "tool_call_id": "call_MggCMW0hbonw102BPYqy8AiQ", "type": "tool_call"}
